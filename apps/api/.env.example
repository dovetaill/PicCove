DATABASE_URL=postgres://piccove:piccove_dev@127.0.0.1:5432/piccove
# Only used to create the first administrator; remove the password after initialization.
PICCOVE_ADMIN_USERNAME=admin
PICCOVE_ADMIN_PASSWORD=
PUBLIC_BASE_URL=http://127.0.0.1:3001
CORS_ORIGIN=http://127.0.0.1:5173
UPLOAD_DIR=./uploads
# Colon-separated absolute roots allowed for adding storage locations; default is UPLOAD_DIR.
# PICCOVE_STORAGE_ROOTS=/data/uploads:/storage
# Dedicated existing import directory; mount read-only in Docker.
# PICCOVE_IMPORT_DIR=/imports
LISTEN_ADDR=127.0.0.1:3001
# Configure before inviting users: https:// contact page or mailto: address.
CONTACT_URL=
RUST_LOG=piccove_api=info,tower_http=info
